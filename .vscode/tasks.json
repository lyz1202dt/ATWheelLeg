{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MCU: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": {"cwd": "${workspaceFolder}/MCU"},
            "problemMatcher": []
        },
        {
            "label": "MCU: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": {"cwd": "${workspaceFolder}/MCU"},
            "dependsOn": "MCU: Configure Debug",
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        }
    ]
}
