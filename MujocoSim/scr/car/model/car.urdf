<?xml version="1.0"?>
<robot name="five_bar_wheel_leg_balance_car">
    <material name="body_mat">
        <color rgba="0.56 0.55 0.41 1.0" />
    </material>
    <material name="link_teal">
        <color rgba="0.0 0.42 0.42 1.0" />
    </material>
    <material name="link_dark">
        <color rgba="0.25 0.27 0.26 1.0" />
    </material>
    <material name="wheel_mat">
        <color rgba="0.0 0.36 0.35 1.0" />
    </material>
    <material name="metal_mat">
        <color rgba="0.72 0.72 0.70 1.0" />
    </material>

    <link name="world" />

    <joint name="floating_base" type="floating">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.1265" rpy="0 0 0" />
            <mass value="2.30" />
            <inertia ixx="0.0423" ixy="0.0" ixz="0.0" iyy="0.0447" iyz="0.0" izz="0.0406" />
        </inertial>
        <visual>
            <origin xyz="0 0 0.06" rpy="0 0 0" />
            <geometry>
                <box size="0.38 0.36 0.12" />
            </geometry>
            <material name="body_mat" />
        </visual>
        <collision>
            <origin xyz="0 0 0.06" rpy="0 0 0" />
            <geometry>
                <box size="0.38 0.36 0.12" />
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.24" rpy="0 0 0" />
            <geometry>
                <box size="0.24 0.22 0.24" />
            </geometry>
            <material name="body_mat" />
        </visual>
        <collision>
            <origin xyz="0 0 0.24" rpy="0 0 0" />
            <geometry>
                <box size="0.24 0.22 0.24" />
            </geometry>
        </collision>
    </link>

    <!-- Left five-bar wheel leg, link plane y=0.17, wheel center y=0.23. -->
    <link name="left_front_upper_link">
        <inertial>
            <origin xyz="0.0922 0 0" rpy="0 0 0" />
            <mass value="0.09" />
            <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00029" iyz="0.0" izz="0.00022" />
        </inertial>
        <visual>
            <origin xyz="0.0922 0 0" rpy="0 1.5704 0" />
            <geometry>
                <cylinder radius="0.012" length="0.1844" />
            </geometry>
            <material name="link_teal" />
