        <child link="left_front_upper_link" />
        <origin xyz="0.11 0.17 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="0.1" upper="1.8" effort="18" velocity="10" />
        <dynamics damping="0.04" friction="0.01" />
