<mujoco model="five_bar_wheel_leg_balance_car">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="RK4"/>

  <worldbody>
    <body name="base_link" pos="0 0 0.36">
      <inertial pos="0 0 0.1265" quat="0.707107 0 0 0.707107" mass="2.3" diaginertia="0.0447 0.0423 0.0406"/>
      <joint name="floating_base" type="free"/>
      <geom size="0.19 0.18 0.06" pos="0 0 0.06" type="box" rgba="0.56 0.55 0.41 1"/>
      <geom size="0.12 0.11 0.12" pos="0 0 0.24" type="box" rgba="0.56 0.55 0.41 1"/>
      <site name="imu" pos="0 0 0.14" size="0.012" rgba="0.1 0.2 0.9 1"/>
      <body name="left_front_upper_link" pos="0.11 0.17 0">
        <inertial pos="0.0922 0 0" quat="0.5 0.5 0.5 0.5" mass="0.09" diaginertia="0.00029 0.00022 0.00012"/>
        <joint name="left_front_hip_joint" pos="0 0 0" axis="0 1 0" range="0.1 1.8" actuatorfrcrange="-18 18" damping="0.04" frictionloss="0.01"/>
        <geom size="0.012 0.0922" pos="0.0922 0 0" quat="0.707247 0 0.706967 0" type="cylinder" rgba="0 0.42 0.42 1"/>
        <body name="left_front_lower_link" pos="0.1844 0 0">
          <inertial pos="0.1565 0 0" quat="0.5 0.5 0.5 0.5" mass="0.12" diaginertia="0.00108 0.00094 0.00018"/>
          <joint name="left_front_knee_joint" pos="0 0 0" axis="0 1 0" range="0 3.14159" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
          <geom size="0.011 0.1565" pos="0.1565 0 0" quat="0.707388 0 -0.706825 0" type="cylinder" rgba="0.25 0.27 0.26 1"/>
          <site name="left_front_closure_site" pos="0.313 0 0" size="0.01" rgba="1 0.2 0.2 1"/>
        </body>
      </body>
      <body name="left_rear_upper_link" pos="-0.11 0.17 0">
        <inertial pos="0.0922 0 0" quat="0.5 0.5 0.5 0.5" mass="0.09" diaginertia="0.00029 0.00022 0.00012"/>
        <joint name="left_rear_hip_joint" pos="0 0 0" axis="0 1 0" range="1.34159 3.04159" actuatorfrcrange="-18 18" damping="0.04" frictionloss="0.01"/>
        <geom size="0.012 0.0922" pos="0.0922 0 0" quat="0.707247 0 0.706967 0" type="cylinder" rgba="0 0.42 0.42 1"/>
        <body name="left_rear_lower_link" pos="0.1844 0 0">
          <inertial pos="0.1565 0 0" quat="0.5 0.5 0.5 0.5" mass="0.12" diaginertia="0.00108 0.00094 0.00018"/>
          <joint name="left_rear_knee_joint" pos="0 0 0" axis="0 1 0" range="-3.14159 0" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
          <geom size="0.011 0.1565" pos="0.1565 0 0" quat="0.707388 0 -0.706825 0" type="cylinder" rgba="0.25 0.27 0.26 1"/>
          <body name="left_wheel_carrier" pos="0.313 0 0">
            <inertial pos="0 0.03 0" quat="0.707107 0.707107 0 0" mass="0.09" diaginertia="8e-05 8e-05 4e-05"/>
            <joint name="left_rear_ankle_joint" pos="0 0 0" axis="0 1 0" range="-2.8 2.8" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
            <site name="left_wheel_carrier_closure_site" pos="0 0 0" size="0.01" rgba="1 0.2 0.2 1"/>
            <geom size="0.025 0.06" pos="0 0.03 0" quat="0.707105 0.707108 0 0" type="cylinder" rgba="0.72 0.72 0.7 1"/>
            <body name="left_wheel" pos="0 0.06 0">
              <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.32" diaginertia="0.0016 0.00102 0.00102"/>
              <joint name="left_wheel_joint" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-16 16" damping="0.01" frictionloss="0.004"/>
              <geom name="left_wheel_tire" size="0.1 0.0275" quat="0.707105 0.707108 0 0" type="cylinder" rgba="0 0.36 0.35 1" friction="1.4 0.04 0.002"/>
            </body>
          </body>
        </body>
      </body>
      <body name="right_front_upper_link" pos="0.11 -0.17 0">
        <inertial pos="0.0922 0 0" quat="0.5 0.5 0.5 0.5" mass="0.09" diaginertia="0.00029 0.00022 0.00012"/>
        <joint name="right_front_hip_joint" pos="0 0 0" axis="0 1 0" range="0.1 1.8" actuatorfrcrange="-18 18" damping="0.04" frictionloss="0.01"/>
        <geom size="0.012 0.0922" pos="0.0922 0 0" quat="0.707247 0 0.706967 0" type="cylinder" rgba="0 0.42 0.42 1"/>
        <body name="right_front_lower_link" pos="0.1844 0 0">
          <inertial pos="0.1565 0 0" quat="0.5 0.5 0.5 0.5" mass="0.12" diaginertia="0.00108 0.00094 0.00018"/>
          <joint name="right_front_knee_joint" pos="0 0 0" axis="0 1 0" range="0 3.14159" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
          <geom size="0.011 0.1565" pos="0.1565 0 0" quat="0.707388 0 -0.706825 0" type="cylinder" rgba="0.25 0.27 0.26 1"/>
          <site name="right_front_closure_site" pos="0.313 0 0" size="0.01" rgba="1 0.2 0.2 1"/>
        </body>
      </body>
      <body name="right_rear_upper_link" pos="-0.11 -0.17 0">
        <inertial pos="0.0922 0 0" quat="0.5 0.5 0.5 0.5" mass="0.09" diaginertia="0.00029 0.00022 0.00012"/>
        <joint name="right_rear_hip_joint" pos="0 0 0" axis="0 1 0" range="1.34159 3.04159" actuatorfrcrange="-18 18" damping="0.04" frictionloss="0.01"/>
        <geom size="0.012 0.0922" pos="0.0922 0 0" quat="0.707247 0 0.706967 0" type="cylinder" rgba="0 0.42 0.42 1"/>
        <body name="right_rear_lower_link" pos="0.1844 0 0">
          <inertial pos="0.1565 0 0" quat="0.5 0.5 0.5 0.5" mass="0.12" diaginertia="0.00108 0.00094 0.00018"/>
          <joint name="right_rear_knee_joint" pos="0 0 0" axis="0 1 0" range="-3.14159 0" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
          <geom size="0.011 0.1565" pos="0.1565 0 0" quat="0.707388 0 -0.706825 0" type="cylinder" rgba="0.25 0.27 0.26 1"/>
          <body name="right_wheel_carrier" pos="0.313 0 0">
            <inertial pos="0 -0.03 0" quat="0.707107 0.707107 0 0" mass="0.09" diaginertia="8e-05 8e-05 4e-05"/>
            <joint name="right_rear_ankle_joint" pos="0 0 0" axis="0 1 0" range="-2.8 2.8" actuatorfrcrange="-3 3" damping="0.02" frictionloss="0.004"/>
            <site name="right_wheel_carrier_closure_site" pos="0 0 0" size="0.01" rgba="1 0.2 0.2 1"/>
            <geom size="0.025 0.06" pos="0 -0.03 0" quat="0.707105 0.707108 0 0" type="cylinder" rgba="0.72 0.72 0.7 1"/>
            <body name="right_wheel" pos="0 -0.06 0">
              <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.32" diaginertia="0.0016 0.00102 0.00102"/>
              <joint name="right_wheel_joint" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-16 16" damping="0.01" frictionloss="0.004"/>
              <geom name="right_wheel_tire" size="0.1 0.0275" quat="0.707105 0.707108 0 0" type="cylinder" rgba="0 0.36 0.35 1" friction="1.4 0.04 0.002"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="left_front_fivebar_closure" site1="left_front_closure_site" site2="left_wheel_carrier_closure_site" solref="0.006 1" solimp="0.95 0.99 0.001"/>
    <connect name="right_front_fivebar_closure" site1="right_front_closure_site" site2="right_wheel_carrier_closure_site" solref="0.006 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <contact>
    <exclude body1="left_front_lower_link" body2="left_wheel_carrier"/>
    <exclude body1="left_front_lower_link" body2="left_rear_lower_link"/>
    <exclude body1="right_front_lower_link" body2="right_wheel_carrier"/>
    <exclude body1="right_front_lower_link" body2="right_rear_lower_link"/>
  </contact>

  <actuator>
    <!-- Left side -->
    <motor name="l1_motor" joint="left_front_hip_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="l2_motor" joint="left_rear_hip_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="lw_motor" joint="left_wheel_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>

    <!-- Right side -->
    <motor name="r1_motor" joint="right_front_hip_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="r2_motor" joint="right_rear_hip_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
    <motor name="rw_motor" joint="right_wheel_joint" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
  </actuator>

  <sensor>
    <!-- actuator position -->
    <actuatorpos name="l1_motor_p" actuator="l1_motor"/>
    <actuatorpos name="l2_motor_p" actuator="l2_motor"/>
    <actuatorpos name="lw_motor_p" actuator="lw_motor"/>
    <actuatorpos name="r1_motor_p" actuator="r1_motor"/>
    <actuatorpos name="r2_motor_p" actuator="r2_motor"/>
    <actuatorpos name="rw_motor_p" actuator="rw_motor"/>

    <!-- actuator velocity -->
    <actuatorvel name="l1_motor_v" actuator="l1_motor"/>
    <actuatorvel name="l2_motor_v" actuator="l2_motor"/>
    <actuatorvel name="lw_motor_v" actuator="lw_motor"/>
    <actuatorvel name="r1_motor_v" actuator="r1_motor"/>
    <actuatorvel name="r2_motor_v" actuator="r2_motor"/>
    <actuatorvel name="rw_motor_v" actuator="rw_motor"/>

    <!-- actuator force -->
    <actuatorfrc name="l1_motor_f" actuator="l1_motor" noise="1e-3"/>
    <actuatorfrc name="l2_motor_f" actuator="l2_motor" noise="1e-3"/>
    <actuatorfrc name="lw_motor_f" actuator="lw_motor" noise="1e-3"/>
    <actuatorfrc name="r1_motor_f" actuator="r1_motor" noise="1e-3"/>
    <actuatorfrc name="r2_motor_f" actuator="r2_motor" noise="1e-3"/>
    <actuatorfrc name="rw_motor_f" actuator="rw_motor" noise="1e-3"/>

    <!-- IMU (imu_main): pose/orientation + acceleration + angular velocity -->
    <accelerometer name="imu_main_acc" site="imu" cutoff="157"/>
    <gyro name="imu_main_gyro" site="imu" cutoff="34.9"/>
    <framequat name="imu_main_quat" objtype="site" objname="imu"/>
  </sensor>
  <!-- <keyframe> -->
    <!-- qpos order: free joint (pos x y z + quat w x y z) followed by joint qpos in appearance order -->
    <!-- <key name="home" qpos="0 0 1 1 0 0 0 0.345 2.35 2.79 -2.35 -2.54 -8.74 0.389 2.28 2.74 -2.28 0.662 0.153" 
    ctrl="0.345 2.79 0.0 0.389 2.74  0.0" />
  </keyframe> -->
</mujoco>
